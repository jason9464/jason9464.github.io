<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% comment %} Items with `pinned: true` are never cut by the limit; they take slots from the oldest unpinned items. {% endcomment %}
        {% assign pinned_size = site.news | where: 'pinned', true | size %}
        {% assign unpinned_limit = news_limit | minus: pinned_size %}
        {% assign unpinned_shown = 0 %}
        {% for item in news %}
          {% unless item.pinned %}
            {% if unpinned_shown >= unpinned_limit %}
              {% continue %}
            {% endif %}
            {% assign unpinned_shown = unpinned_shown | plus: 1 %}
          {% endunless %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
